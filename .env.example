APP_NAME="SKIM App"
APP_ENV=local
APP_DEBUG=true
# APP_KEY — 32-byte secret used to sign cookies and encrypt session data.
# Generate with: php skim install  (auto-filled)
# or manually:  php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Leave blank in dev; required in production if cookie/session signing is enabled.
APP_KEY=

# Primary database (MySQL)
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=skim_dev
DB_USER=skim
DB_PASS=secret

# Analytics database (PostgreSQL) — optional second connection.
# Named "analytics" because it is a read-heavy reporting DB kept separate from the
# primary transactional DB so heavy queries cannot slow down the main app.
# Any name works — add more connections in config/db.php and reference them via
# db::row(..., connection: 'analytics').
ANALYTICS_DB_HOST=pgsql
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=skim_analytics
ANALYTICS_DB_USER=skim
ANALYTICS_DB_PASS=secret

# Cache
CACHE_DRIVER=redis

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# Logging
# LOG_CHANNEL options:
#   file  — writes to storage/logs/app.log, rotated every N days (see config/app.php)
#   null  — discards all log output (useful in testing / CI)
#   (custom) — inject any PSR-3 compatible handler via log::set_handler() in bootstrap
LOG_CHANNEL=file

# LOG_LEVEL options (RFC 5424, least → most severe):
#   debug | info | notice | warning | error | critical | alert | emergency
# Messages below this level are silently dropped by the file handler.
LOG_LEVEL=debug
