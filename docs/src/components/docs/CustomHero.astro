---
---
<div class="custom-hero">
  <div class="canvas-container">
    <canvas id="c"></canvas>
  </div>
  
  <p class="hero-tagline">PHP 8.5+ micro-framework — minimal core, zero magic, snake_case everything. Docs that work as well for your AI agent as they do for you.</p>
  
  <div class="hero-actions">
    <a href="/api/" class="btn-primary">API Reference</a>
    <a href="https://github.com/skim-framework/skim" class="btn-secondary" target="_blank" rel="noopener noreferrer">
      GitHub
      <svg class="external-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
        <path d="M10 6V8H5V19H14V14H16V19C16 20.1 15.1 21 14 21H5C3.9 21 3 20.1 3 19V8C3 6.9 3.9 6 5 6H10ZM21 3V11H19V6.41L11.71 14.21L10.29 12.79L17.59 5H13V3H21Z" />
      </svg>
    </a>
  </div>
</div>

<style>
  .custom-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 1.5rem;
    margin-top: -2rem;
    width: 100%;
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
  }

  .canvas-container {
    width: 100%;
    max-width: 1000px;
    height: 320px;
    position: relative;
    margin-bottom: 2.5rem;
    overflow: hidden;
  }

  #c {
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
    margin-bottom: 1.5rem;
    font-family: var(--sl-font-heading);
  }

  .hero-tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
    max-width: 48rem;
    margin-bottom: 2.5rem;
    font-weight: 400;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    width: 100%;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 999px;
    background: var(--sl-color-accent-high);
    color: #ffffff !important;
    text-decoration: none !important;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  :global([data-theme="light"]) .btn-primary {
    background: var(--sl-color-accent) !important;
    color: #ffffff !important;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    filter: brightness(1.15);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: #ffffff !important;
    border: 1px solid var(--sl-color-gray-5);
    text-decoration: none !important;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  :global([data-theme="light"]) .btn-secondary {
    background: var(--sl-color-gray-6) !important;
    color: var(--sl-color-gray-1) !important;
    border: 1px solid var(--sl-color-gray-4) !important;
  }

  .btn-secondary:hover {
    transform: translateY(-2px);
    background: var(--sl-color-gray-5);
  }

  :global([data-theme="light"]) .btn-secondary:hover {
    background: var(--sl-color-gray-5) !important;
  }

  .external-icon {
    opacity: 0.75;
  }
</style>

<script>
const ASCII = `                                      v    v v     v v  v vv    vvvv  v v    v v v    v   vv  v
                                    v  v                       vv        v         v        v     v
                               v          vv  v vv v  vvv vvvvvv vvvv  vv vv    vvvv v          v  v    v
