---
interface Props {
  label: string;
  source?: string;
  collapsed?: boolean;
}

const { label, source, collapsed = false } = Astro.props;
---

<details class="code-example not-content" open={!collapsed}>
  <summary class="code-example__header">
    <div class="code-example__header-left">
      <span class="code-example__toggle-icon">
        <i class="ti ti-chevron-right" aria-hidden="true"></i>
      </span>
      <span class="code-example__label">{label}</span>
    </div>
    {source === 'llm-generated' && (
      <span class="code-example__badge" title="This example was automatically generated by an LLM based on its strict #ai* contract annotations.">
        <i class="ti ti-robot" aria-hidden="true"></i>
        AI Generated
      </span>
    )}
  </summary>
  <div class="code-example__body">
    <slot />
  </div>
</details>

<style>
  .code-example {
    margin: 1.25rem 0;
    border: 0.5px solid var(--docs-border);
    border-radius: 8px;
    background: var(--sl-color-bg-sidebar);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .code-example:hover {
    border-color: var(--docs-border-strong);
  }

  .code-example__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 1rem;
    background: var(--docs-bg-deep);
    cursor: pointer;
    user-select: none;
    list-style: none; /* Hide default arrow */
    border-bottom: 0.5px solid transparent;
  }

  /* Hide default details marker in WebKit/Blink */
  .code-example__header::-webkit-details-marker {
    display: none;
  }

  .code-example[open] .code-example__header {
    border-bottom-color: var(--docs-border);
  }

  .code-example__header-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .code-example__toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: var(--docs-text-secondary);
    transition: transform 0.2s ease;
  }

  .code-example[open] .code-example__toggle-icon {
    transform: rotate(90deg);
  }

  .code-example__label {
    font-size: 12px;
    font-weight: 600;
    color: var(--docs-text-primary);
    letter-spacing: 0.2px;
  }

  .code-example__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(191, 150, 229, 0.05);
    color: var(--docs-badge-facade-fg);
    border: 0.5px solid rgba(191, 150, 229, 0.15);
  }

  .code-example__body {
    padding: 0;
  }

  /* Target nested pre/code generated by MDX */
  .code-example__body :global(pre) {
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    font-size: 12.5px !important;
  }
</style>
