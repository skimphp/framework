---
interface Props {
  type: string;
}

const { type } = Astro.props;
---
<div class="api-throws not-content">
  <span class="api-throws__label">throws</span>
  <span class="api-throws__type">{type}</span>
  <div class="api-throws__desc"><slot /></div>
</div>

<style>
  .api-throws {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 0.6rem 0;
    border-top: 0.5px solid rgba(255, 255, 255, 0.04);
  }
  [data-theme="light"] .api-throws { border-top-color: var(--docs-border); }

  .api-throws__label {
    font-size: 11px;
    font-weight: 600;
    color: var(--docs-tag-throws-fg);
    font-family: var(--sl-font-mono);
    min-width: 86px;
    flex-shrink: 0;
    padding-top: 1px;
  }
  .api-throws__type {
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 999px;
    font-weight: 500;
    font-family: var(--sl-font-mono);
    background: rgba(224, 122, 95, 0.10);
    color: var(--docs-tag-throws-fg);
    border: 0.5px solid rgba(224, 122, 95, 0.30);
    flex-shrink: 0;
  }
  .api-throws__desc { font-size: 12.5px; color: var(--docs-text-secondary); line-height: 1.6; flex: 1; }
</style>
