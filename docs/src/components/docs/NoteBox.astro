---
---
<aside class="callout callout--note not-content">
  <p class="callout__label">
    <i class="ti ti-bulb" aria-hidden="true"></i>
    Note
  </p>
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    border: 0.5px solid;
    border-left-width: 2.5px;
    border-radius: 0 8px 8px 0;
    padding: 0.875rem 1.1rem;
    margin: 1.25rem 0;
  }
  .callout--note {
    background: var(--docs-note-bg);
    border-color: var(--docs-note-border);
    border-left-color: var(--docs-note-accent);
  }
  .callout__label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 5px;
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--docs-note-accent);
  }
  .callout--note .callout__body { font-size: 13px; color: var(--docs-note-text); line-height: 1.65; }
  .callout--note .callout__body :global(code) {
    background: var(--docs-note-code-bg);
    color: var(--docs-note-code-fg);
    padding: 1px 5px;
    border-radius: 4px;
    font-family: var(--sl-font-mono);
    font-size: 11.5px;
  }
</style>
