{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skim-framework.dev/schema/extracted.json",
  "title": "SKIM llm.json schema",
  "description": "Schema for the llm.json file generated by docs:extract. This is the single source of truth for all documentation outputs.",
  "type": "object",
  "required": ["generated_at", "classes"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when this file was generated"
    },
    "classes": {
      "type": "array",
      "description": "All extracted classes from the scanned source paths",
      "items": {
        "$ref": "#/$defs/extracted_class"
      }
    }
  },
  "$defs": {
    "extracted_class": {
      "type": "object",
      "required": ["class_name", "namespace", "file", "summary", "lifecycle", "owner", "methods"],
      "properties": {
        "class_name": { "type": "string", "description": "snake_case class name without namespace" },
        "namespace":  { "type": "string", "description": "PHP namespace e.g. skim\\core" },
        "file":       { "type": "string", "description": "Absolute path to the source file" },
        "summary":    { "type": "string", "description": "First non-tag line of the class docblock" },
        "lifecycle":  { "type": "string", "description": "@ai.lifecycle tag value; empty if not present" },
        "owner":      { "type": "string", "description": "@ai.owner tag value; empty if not present" },
        "methods":    {
          "type": "array",
          "items": { "$ref": "#/$defs/extracted_method" }
        }
      }
    },
    "extracted_method": {
      "type": "object",
      "required": ["name", "signature", "owner", "contracts", "invariants", "non_goals", "side_effects", "lifecycle", "perf", "throws"],
      "properties": {
        "name":         { "type": "string", "description": "Method name" },
        "signature":    { "type": "string", "description": "Full PHP signature string" },
        "owner":        { "type": "string", "description": "Fully-qualified class name" },
        "contracts":    { "type": "array", "items": { "type": "string" }, "description": "@ai.contract tag values" },
        "invariants":   { "type": "array", "items": { "type": "string" }, "description": "@ai.invariant tag values" },
        "non_goals":    { "type": "array", "items": { "type": "string" }, "description": "@ai.non_goal tag values" },
        "side_effects": { "type": "array", "items": { "type": "string" }, "description": "@ai.side_effect tag values" },
        "lifecycle":    { "type": "string", "description": "@ai.lifecycle tag value; empty if not present" },
        "perf":         { "type": "string", "description": "@ai.perf tag value; empty if not present" },
        "throws":       { "type": "array", "items": { "type": "string" }, "description": "@ai.throws tag values" }
      }
    }
  }
}
