FROM dunglas/frankenphp:latest

WORKDIR /app

# Install system deps and PHP extensions
RUN apt-get update && apt-get install -y \
    git unzip curl \
    libzip-dev icu-devtools libicu-dev \
    libpq-dev \
    libonig-dev \
    libsqlite3-dev \
    && install-php-extensions \
        pdo_mysql \
        pdo_pgsql \
        pdo_sqlite \
        mbstring \
        intl \
        zip \
        bcmath \
        pcntl \
        posix \
        sockets \
        redis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install PHP deps
# composer.lock is gitignored, so resolve versions from composer.json only —
# a clean checkout build must not depend on a locally-generated lockfile.
COPY composer.json /app/
RUN composer install --no-interaction --prefer-dist --optimize-autoloader --no-dev

# Copy app code
COPY . /app

COPY Caddyfile /etc/frankenphp/Caddyfile

ENV FRANKENPHP_CONFIG="worker /app/public/worker.php"

EXPOSE 80 443